{
  "version": 1,
  "sdk_version": "2.0.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://snqrnpphjjskjtupwlfp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nutrio-your-uk-nutrition-coach",
      "version": "0.1.0",
      "title": "Nutrio: Your UK Nutrition Coach"
    },
    "tools": [
      {
        "name": "get_daily_summary",
        "title": "Get daily nutrition summary",
        "description": "Get the signed-in user's calories, macros, water and workouts for a given day, compared with their targets.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "date": {
              "description": "Day to summarise in YYYY-MM-DD format. Defaults to today.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_progress",
        "title": "Get recent progress",
        "description": "Get the signed-in user's goal profile, recent weight history and recent daily calorie totals over a number of days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "days": {
              "description": "How many days back to look. Defaults to 14.",
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "log_food",
        "title": "Log a food item",
        "description": "Add a food item with its calories and macros to the signed-in user's diary.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "food_name": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the food or meal."
            },
            "meal_type": {
              "type": "string",
              "enum": [
                "breakfast",
                "lunch",
                "dinner",
                "snacks"
              ],
              "description": "Which meal this food belongs to."
            },
            "calories": {
              "type": "number",
              "minimum": 0,
              "description": "Calories (kcal)."
            },
            "protein": {
              "description": "Protein in grams.",
              "type": "number",
              "minimum": 0
            },
            "carbs": {
              "description": "Carbohydrates in grams.",
              "type": "number",
              "minimum": 0
            },
            "fat": {
              "description": "Fat in grams.",
              "type": "number",
              "minimum": 0
            },
            "fibre": {
              "description": "Fibre in grams.",
              "type": "number",
              "minimum": 0
            },
            "quantity": {
              "description": "Portion quantity, defaults to 1.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "description": "Portion unit, e.g. g, ml, serving.",
              "type": "string"
            }
          },
          "required": [
            "food_name",
            "meal_type",
            "calories"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "log_water",
        "title": "Log water intake",
        "description": "Record glasses of water for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "glasses": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "Number of glasses of water to add."
            }
          },
          "required": [
            "glasses"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "log_workout",
        "title": "Log a workout",
        "description": "Record a completed workout for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "exercise_name": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the exercise or session."
            },
            "exercise_type": {
              "type": "string",
              "enum": [
                "strength",
                "core",
                "endurance",
                "yoga",
                "other"
              ],
              "description": "Category of the workout."
            },
            "duration_minutes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Duration in minutes."
            },
            "calories_burned": {
              "description": "Estimated calories burned.",
              "type": "number",
              "minimum": 0
            },
            "intensity": {
              "description": "Perceived intensity.",
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            },
            "notes": {
              "description": "Optional notes about the session.",
              "type": "string"
            }
          },
          "required": [
            "exercise_name",
            "exercise_type",
            "duration_minutes"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "log_weight",
        "title": "Log body weight",
        "description": "Record the signed-in user's body weight for a given day.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "weight_kg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 500,
              "description": "Body weight in kilograms."
            },
            "recorded_on": {
              "description": "Date of the reading in YYYY-MM-DD format. Defaults to today.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "weight_kg"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
